# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb://localhost:27017/kwickdrop

# CORS and Public URLs
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Limits & Retention Defaults
MAX_FILE_SIZE_BYTES=10485760
MAX_TEXT_SIZE_BYTES=102400
DEFAULT_SHARE_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=15

# Storage Provider: 'cloudinary' or 'mock' (default: cloudinary, mock is useful for local dev without credentials and automated testing)
STORAGE_PROVIDER=mock
